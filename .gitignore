# Git worktrees managed by Claude
.claude/worktrees/
# Quantity takeoff uploads (drawings, converted DXF, renders)
backend/temp/takeoff/
backend/temp/bbs/
backend/temp/drawings/

# Local data: never commit (reports, uploads, databases)
backend/temp/*
!backend/temp/.gitkeep
*.db
*.sqlite
*.sqlite3

# Claude Code: keep only the shared launch config
.claude/*
!.claude/launch.json
