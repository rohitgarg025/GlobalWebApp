*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/

# FastAPI / uvicorn
*.log

# Environment variables
.env
.env.*
!.env.example

# macOS
.DS_Store
.AppleDouble
.LSOverride

# IDE
.idea/
.vscode/
*.swp
*.swo

# Flutter / Dart
flutter_app/.dart_tool/
